# Fichier d'exemple pour gradle.properties local (ne pas commiter)
# Copiez ce fichier vers gradle.properties et remplissez vos valeurs

# Project
android.useAndroidX=true
android.enableJetifier=false
# AGP 9 with the Kotlin Multiplatform plugin: keep Kotlin and the DSL as KMP expects them
android.builtInKotlin=false
android.newDsl=false

# Signing
signing.keyId=XXXXXXXXX
signing.password=XXXXXXXXX
signing.secretKeyRingFile=/path/to/secret

# OSSRH Credentials
ossrhUsername=XXXXXXXXX
ossrhPassword=XXXXXXXXX
